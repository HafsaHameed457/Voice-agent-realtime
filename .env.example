# Required
GROQ_API_KEY=gsk_your_groq_api_key_here

# Server
PORT=5050
HOST=0.0.0.0

# Groq
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Agent
SYSTEM_MESSAGE="You are a cheerful and bubbly customer support agent who deals with customers efficiently and says haha now and then please."
TEMPERATURE=0.8

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional
WEBHOOK_URL=
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=voice_agent