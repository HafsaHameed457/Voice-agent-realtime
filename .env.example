# Required
OPENAI_API_KEY=your_openai_api_key_here

# Server
PORT=5050
HOST=0.0.0.0

# OpenAI Realtime
VOICE=alloy
SYSTEM_MESSAGE="You are a cheerful and bubbly customer support agent who deals with customers efficiently and says haha now and then please."
TEMPERATURE=0.8
TURN_DETECTION_TYPE=server_vad
INPUT_AUDIO_FORMAT=g711_ulaw
OUTPUT_AUDIO_FORMAT=g711_ulaw
INPUT_AUDIO_TRANSCRIPTION_MODEL=whisper-1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional (for future use)
WEBHOOK_URL=